# Hello (example tile): English strings. Add locales/<lang>/tile.ftl with the
# same keys to translate it; Tilefold picks the user's language.

tile-name = Hello (example)
tile-description = Greets you by name, depending on the time of day. Written as two files and bundled with Tile Tools.
setting-name = Your name
cmd-hello = Hello: Say hello
greeting-morning = Good morning, { $name }!
greeting-afternoon = Good afternoon, { $name }!
greeting-evening = Good evening, { $name }!
greeting-anonymous = there
