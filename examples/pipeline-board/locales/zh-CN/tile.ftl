tile-name = 流水线看板（示例）
tile-description = 在窗格一角显示 GitLab 项目最新的 CI 流水线，完成时给出通知。
cmd-toggle = 流水线看板：显示或隐藏
cmd-refresh = 流水线看板：刷新
setting-project = GitLab 项目（例如 gitlab-org/gitlab）
setting-ref = 分支（留空表示所有分支）
setting-corner = 窗格的角落
setting-corner-bottom-right = 右下
setting-corner-bottom-left = 左下
setting-corner-top-right = 右上
setting-corner-top-left = 左上
setting-notify = 流水线完成时显示通知
status-running = 运行中
status-pending = 等待中
status-success = 成功
status-failed = 失败
status-canceled = 已取消
status-manual = 手动
age-now = 刚刚
age-minutes = { $n } 分钟前
age-hours = { $n } 小时前
age-days = { $n } 天前
age-unknown = –
board-empty = 还没有流水线。
board-label = { $project } 的流水线：最新为{ $status }
notice-success = { $ref } 上的流水线 #{ $n } 已成功。
notice-failed = { $ref } 上的流水线 #{ $n } 已失败。
notice-canceled = { $ref } 上的流水线 #{ $n } 已取消。
notice-manual = { $ref } 上的流水线 #{ $n } 正在等待手动作业。
state-no-network = 无法连接 GitLab
state-no-network-hint = 此 Tilefold 版本太旧，无法使用流水线看板；请更新 Tilefold。
state-signed-out = 未登录 GitLab
state-signed-out-hint = 请在 设置 → 磁贴 中流水线看板卡片的“密钥”下登录。
state-no-project = 哪个项目？
state-no-project-hint = 请在 设置 → 磁贴 中流水线看板的设置里填写 GitLab 项目。
state-loading = 正在询问 GitLab…
state-loading-hint = 请稍候。
state-not-found = 找不到项目
state-not-found-hint = GitLab 没有向你显示“{ $project }”。请检查路径，或确认你的账号可以查看它。
state-denied = 流水线看板未获准连接 GitLab
state-denied-hint = 请在 设置 → 磁贴 中流水线看板的卡片上允许。
state-rate = GitLab 要求降低频率
state-rate-hint = 五分钟后再次检查。
state-error = GitLab 没有响应
state-error-hint = 稍后将重试。点击看板可立即重试。
