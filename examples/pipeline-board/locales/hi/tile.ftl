tile-name = पाइपलाइन बोर्ड (उदाहरण)
tile-description = किसी GitLab प्रोजेक्ट की नवीनतम CI पाइपलाइनें आपके पैन के एक कोने में, और किसी के पूरा होने पर सूचना।
cmd-toggle = पाइपलाइन बोर्ड: दिखाएँ या छिपाएँ
cmd-refresh = पाइपलाइन बोर्ड: रीफ़्रेश करें
setting-project = GitLab प्रोजेक्ट (जैसे gitlab-org/gitlab)
setting-ref = ब्रांच (सभी ब्रांच के लिए खाली)
setting-corner = पैन का कोना
setting-corner-bottom-right = नीचे दाएँ
setting-corner-bottom-left = नीचे बाएँ
setting-corner-top-right = ऊपर दाएँ
setting-corner-top-left = ऊपर बाएँ
setting-notify = पाइपलाइन पूरी होने पर सूचना दिखाएँ
status-running = चल रही है
status-pending = प्रतीक्षा में
status-success = सफल
status-failed = विफल
status-canceled = रद्द
status-manual = मैनुअल
age-now = अभी
age-minutes = { $n } मिनट पहले
age-hours = { $n } घंटे पहले
age-days = { $n } दिन पहले
age-unknown = –
board-empty = अभी कोई पाइपलाइन नहीं।
board-label = { $project } की पाइपलाइनें: नवीनतम { $status }
notice-success = { $ref } पर पाइपलाइन #{ $n } सफल रही।
notice-failed = { $ref } पर पाइपलाइन #{ $n } विफल रही।
notice-canceled = { $ref } पर पाइपलाइन #{ $n } रद्द कर दी गई।
notice-manual = { $ref } पर पाइपलाइन #{ $n } एक मैनुअल जॉब की प्रतीक्षा में है।
state-no-network = GitLab तक नहीं पहुँच सकते
state-no-network-hint = यह Tilefold पाइपलाइन बोर्ड के लिए बहुत पुराना है; Tilefold अपडेट करें।
state-signed-out = GitLab में साइन इन नहीं है
state-signed-out-hint = सेटिंग्स → टाइल्स में पाइपलाइन बोर्ड के कार्ड पर कुंजियाँ के अंतर्गत साइन इन करें।
state-no-project = कौन-सा प्रोजेक्ट?
state-no-project-hint = सेटिंग्स → टाइल्स में पाइपलाइन बोर्ड की सेटिंग्स में GitLab प्रोजेक्ट चुनें।
state-loading = GitLab से पूछ रहे हैं…
state-loading-hint = एक पल।
state-not-found = प्रोजेक्ट नहीं मिला
state-not-found-hint = GitLab आपको "{ $project }" नहीं दिखाता। पाथ जाँचें, या देखें कि आपका खाता इसे देख सकता है।
state-denied = पाइपलाइन बोर्ड को GitLab तक पहुँचने की अनुमति नहीं है
state-denied-hint = सेटिंग्स → टाइल्स में पाइपलाइन बोर्ड के कार्ड पर इसकी अनुमति दें।
state-rate = GitLab ने धीमा करने को कहा
state-rate-hint = पाँच मिनट में फिर जाँच होगी।
state-error = GitLab ने जवाब नहीं दिया
state-error-hint = जल्द फिर कोशिश होगी। अभी कोशिश करने के लिए बोर्ड पर क्लिक करें।
