# Agent Pack (example tile): German strings.

tile-name = Agent Pack (Beispiel)
tile-description = Fügt KI-Coding-Agenten, die Tilefold noch nicht kennt, etwa Grok Build, Kimi CLI und Mistral Vibe, zu Ihren eigenen Agenten hinzu. Tilefold zeigt Ihnen jeden zuerst und fügt ihn nur nach Ihrer Bestätigung hinzu.
cmd-add-grok = Agent Pack: Grok Build hinzufügen
cmd-add-kimi = Agent Pack: Kimi CLI hinzufügen
cmd-add-vibe = Agent Pack: Mistral Vibe hinzufügen
cmd-add-qwen = Agent Pack: Qwen Code hinzufügen
cmd-add-aider = Agent Pack: Aider hinzufügen
cmd-add-goose = Agent Pack: Goose hinzufügen
cmd-add-crush = Agent Pack: Crush hinzufügen
toast-added = { $name } wurde zu Ihren eigenen Agenten hinzugefügt (Einstellungen → Agenten).
toast-exists = { $name } ist bereits einer Ihrer Agenten.
toast-declined = { $name } wurde nicht hinzugefügt.
toast-full = Sie haben bereits 20 eigene Agenten; entfernen Sie zuerst einen unter Einstellungen → Agenten.
toast-refused = Tilefold konnte { $name } nicht speichern.
toast-failed = Der Agent konnte nicht angeboten werden ({ $reason }).
toast-needs-tilefold = Agenten aus einer Kachel hinzuzufügen erfordert ein neueres Tilefold.
