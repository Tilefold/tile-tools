tile-name = Webansicht (Beispiel)
tile-description = Zeigt die Web-App, die du baust, etwa localhost:5173, in einem Browserfenster neben deinen Bereichen und listet die zuletzt geöffneten Seiten.
setting-address = Zu öffnende Ports auf localhost, durch Kommas getrennt: Jeder öffnet localhost:PORT auf einer eigenen Seite (5173, 3000). Ein Bereich wie 3000-3010 öffnet jeden Port darin. Vollständige Adressen wie staging.example.com gehen auch.
setting-docked = Neben den Bereichen zeigen (aus: in einem eigenen Fenster)
setting-panel = Letzte Seiten neben den Bereichen zeigen
cmd-open = Webansicht: Öffnen
cmd-move = Webansicht: Neben den Bereichen oder im Fenster
cmd-reload = Webansicht: Neu laden
cmd-back = Webansicht: Zurück
cmd-forward = Webansicht: Vorwärts
cmd-close = Webansicht: Schließen
cmd-clear = Webansicht: Letzte Seiten vergessen
panel-title = Webansicht
panel-subtitle = Letzte Seiten
recent-cleared = Letzte Seiten vergessen.
error-no-browser = Dieses Tilefold kann für Kacheln noch keinen Browser öffnen. Aktualisiere Tilefold, um die Webansicht zu nutzen.
error-refused = Die Webansicht konnte das nicht öffnen: { $reason }
error-failed = Beim Vorschaufenster ist etwas schiefgelaufen. Versuch es noch einmal.
error-one-page = Dieses Tilefold zeigt nur eine Seite auf einmal, daher hat Web View nur die erste Adresse geöffnet. Aktualisiere Tilefold, um alle zu öffnen.
